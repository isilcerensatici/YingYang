bolum_adi = "Bölüm 3"
bolum_aciklamasi = "İlk olarak Yin siyah lambaya temas ederek etrafı siyah yapar ve Yang görünür olur. Sonrasında Yang Mavi lambaya temas eder etraf mavi olur ve her şey görünür olur. Ardından anahtarları toplayarak Güneş'i ortaya çıkarın.
"

