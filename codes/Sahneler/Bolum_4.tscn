bolum_adi = "Bölüm 4"
bolum_aciklamasi = "Anahtarları topladıktan sonra iki tane buton ortaya çıkar. Yang ın siyah butona Yin in de beyaz butona aynı anda basması lazım. Sonrasında ise bir şeylerden kaçmanız gerekiyor. Kaçmayı başarırsanız Güneş ortaya çıkacaktır. Başarılar."

