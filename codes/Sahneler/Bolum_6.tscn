bolum_adi = "Bölüm 6"
bolum_aciklamasi = "Yang ın kafesini açmak için Yin in beyaz anahtarları toplaması gerekir. Anahtarları topladıktan sonra bir buton çıkacaktır. o Buton Yang ı serbest bırakır. Aynısını Yang da Yin için yapacaktır. Sonrasında ise Güneş ortaya çıkar. Ama dikkat edin platformlarda bir gariplik var.."

